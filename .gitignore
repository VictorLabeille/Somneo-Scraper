# Environnements Python
venv/
__pycache__/
*.py[cod]

# Loaders Radxa : binaires de 1,4 Mo retelechargeables depuis dl.radxa.com
radxa-flash/*.bin

# Clone de pyamlboot (depot git imbrique, ~28 Mo)
# A convertir en submodule si on veut le versionner proprement.
radxa-flash/pyamlboot/

# Journaux de session
radxa-flash/*.log

# Images systeme
*.img
*.img.xz

# Captures longues : numero de serie, adresse MAC et conditions de la chambre en continu.
# Leur place est la base du collecteur, pas git.
probes/captures/
probes/results/capture*.jsonl
